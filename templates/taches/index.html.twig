{% extends 'base.html.twig' %}

{% block title %}Liste des taches{% endblock %}

{% block body %}
    <h1 class="mb-4">📰 Taches (depuis la BDD)</h1>

    {% if articles is empty %}
        <div class="alert alert-info">
            Aucune tache en base de données. 
            <a href="{{ path('app_tache_nouvelle') }}" class="alert-link">Créer une tache</a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-bordered table-hover mt-4">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Titre</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tache in taches %}
                        <tr>
                            <td class="text-center">{{ tache.titre }}</td>
                            <td>{{ tache.description }}</td>
                            <td>{{ tache.terminee }}</td>
                            <td>{{ tache.dateCreation|date('d/m/Y') }}</td>
                            
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="mt-3 text-muted">
            {{ taches|length }} tache(s) en base de données
        </p>
    {% endif %}
{% endblock %}