{% extends 'base.html.twig' %}

{% block title %}{{ categorie.nom }}{% endblock %}

{% block body %}
    <h1 class="display-4">📂 {{ categorie.nom }}</h1>

    {% if categorie.description %}
        <p class="text-muted mb-4 pb-2 border-bottom">{{ categorie.description }}</p>
    {% endif %}

    <div class="mb-4">
        <strong>{{ categorie.articles|length }}</strong> article(s) dans cette catégorie
    </div>

    {% if categorie.articles is not empty %}
        <div class="list-group mb-4">
            {% for article in categorie.articles %}
                <a href="{{ path('app_article_detail', {id: article.id}) }}" class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">{{ article.titre }}</h5>
                        <small class="text-muted">{{ article.dateCreation ? article.dateCreation|date('d/m/Y') : '' }}</small>
                    </div>
                    <p class="mb-1 text-truncate">{{ article.contenu }}</p>
                </a>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">Aucun article dans cette catégorie.</div>
    {% endif %}

    <div class="d-flex gap-2 align-items-center">
        <a href="{{ path('app_categorie_modifier', {id: categorie.id}) }}" class="btn btn-primary">✏️ Modifier</a>

        <form method="post" action="{{ path('app_categorie_supprimer', {id: categorie.id}) }}"
              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?');" class="d-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('supprimer_' ~ categorie.id) }}">
            <button type="submit" class="btn btn-danger">🗑️ Supprimer</button>
        </form>

        <a href="{{ path('app_categories') }}" class="btn btn-outline-secondary">← Retour aux catégories</a>
    </div>
{% endblock %}
